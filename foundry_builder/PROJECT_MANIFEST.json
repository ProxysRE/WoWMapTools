{
  "project": "Генератор JSON для импорта в FoundryVTT",
  "manifest_version": 25,
  "canonical_directory": "/Генератор JSON для импорта в FoundryVTT",
  "targets": {
    "foundry": "13.351",
    "export_core": "13.347",
    "dnd5e": "5.3.3",
    "midi-qol": "13.0.64",
    "dae": "13.0.29",
    "enhancements_module": "0.7.0"
  },
  "update_policy": {
    "mode": "replace_in_place",
    "forbid_numbered_copies": true,
    "forbidden_name_pattern": "\\(\\d+\\)(?=\\.[^.]+$)",
    "rule": "При изменении существующего файла всегда заменять файл с тем же каноническим именем и сохранять его историю версий. Не создавать копии (1), (2), v2, final или fixed.",
    "new_file_rule": "Создавать новый файл разрешено только для новой самостоятельной сущности с новым смысловым именем."
  },
  "pipeline": [
    "actor_builder.py",
    "feat_builder.py",
    "weapon_builder.py",
    "equipment_builder.py",
    "spell_builder.py",
    "consumable_builder.py",
    "item_builder.py",
    "enhancement_builder.py",
    "enhancement_set_builder.py",
    "rolltable_builder.py",
    "build_enhancement_module.py",
    "class_builder.py",
    "subclass_builder.py",
    "race_builder.py",
    "background_builder.py",
    "class_package_builder.py",
    "foundry_module_builder.py"
  ],
  "entry_point": "build_npc.py",
  "gui_entry_point": "builder_app.py",
  "package_entry_point": "package_project.py",
  "canonical_files": {
    "application": [
      "builder_app.py",
      "package_project.py",
      "project_config.py",
      "start_builder_app.bat"
    ],
    "builders": [
      "actor_builder.py",
      "build_enhancement_module.py",
      "build_npc.py",
      "consumable_builder.py",
      "enhancement_builder.py",
      "enhancement_policy.py",
      "enhancement_set_builder.py",
      "equipment_builder.py",
      "feat_builder.py",
      "item_builder.py",
      "rolltable_builder.py",
      "spell_builder.py",
      "weapon_builder.py"
    ],
    "templates": [
      "templates.json",
      "enhancement_test_set.json"
    ],
    "documentation": [
      "AI_FOUNDRY_BUILDER_GUIDE.md",
      "docs/COMMON_JSON.md",
      "docs/CONSUMABLES_JSON.md",
      "docs/CONTENT_DESIGN.md",
      "docs/EQUIPMENT_JSON.md",
      "docs/ENHANCEMENTS_JSON.md",
      "docs/ENHANCEMENTS_README.md",
      "docs/FEATURES_JSON.md",
      "docs/ITEMS_JSON.md",
      "docs/ITEM_ENHANCEMENT_POLICY.md",
      "docs/NPC_JSON.md",
      "docs/PROJECT_MAINTENANCE.md",
      "docs/SPELLS_JSON.md",
      "docs/VALIDATION.md",
      "docs/WEAPONS_JSON.md",
      "AI_CONTENT_PACKAGE_GUIDE.md",
      "AI_CLASS_SUBCLASS_JSON_GUIDE.md",
      "AI_FEATURE_JSON_GUIDE.md",
      "docs/BACKGROUNDS_JSON.md",
      "README.md"
    ],
    "validation": [
      "project_audit.py",
      "midi_compat.py"
    ],
    "runtime": [
      "runtime/foundry-json-builder-enhancements/scripts/enhancement-groups.mjs",
      "runtime/resource-pools.mjs"
    ],
    "character_content": [
      "character_builder.py",
      "class_builder.py",
      "subclass_builder.py",
      "race_builder.py",
      "background_builder.py",
      "class_package_builder.py",
      "foundry_module_builder.py",
      "package_validation.py",
      "compendium_layout.py",
      "character_test_support.py"
    ],
    "character_examples": [
      "class_input_template.json",
      "race_input_template.json",
      "class_reference_catalog.json",
      "subclass_reference_catalog.json",
      "examples/content_package.json",
      "examples/standard_options.json"
    ],
    "character_tests": [
      "tests/test_character_packages.py",
      "tests/test_install_archive.py",
      "tests/test_leveldb_roundtrip.py",
      "tests/test_racial_content.py",
      "tests/test_resource_runtime.mjs",
      "tests/test_standard_options.py"
    ]
  },
  "application_version": "1.6.0",
  "character_entry_point": "character_builder.py"
}
